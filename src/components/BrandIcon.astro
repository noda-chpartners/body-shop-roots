---
import { siInstagram, siLine } from 'simple-icons';
import type { BrandIconName } from '@/content/siteContent';

interface Props {
  name: BrandIconName;
  size?: number;
}

const { name, size = 22 } = Astro.props;

const icons = {
  instagram: siInstagram,
  line: siLine,
};

const icon = icons[name];
---

<svg
  class="brand-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
>
  <path d={icon.path}></path>
</svg>
