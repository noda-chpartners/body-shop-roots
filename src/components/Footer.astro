---
import { Image } from 'astro:assets';
import BrandIcon from './BrandIcon.astro';
import { siteContent } from '@/content/siteContent';
---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <div class="site-footer__brand">
      <Image
        class="site-footer__logo"
        src={siteContent.brand.logo}
        alt=""
        width={72}
        height={72}
      />
      <p class="site-footer__name">{siteContent.brand.name}</p>
    </div>
    <div class="site-footer__socials">
      {
        siteContent.social.map((item) => (
          <div class="social-account">
            <BrandIcon name={item.icon} size={21} />
            <div class="social-account__copy">
              <span class="social-account__label">{item.label}</span>
              <span class="social-account__handle">{item.handle}</span>
            </div>
          </div>
        ))
      }
    </div>
    <a class="site-footer__top" href="#top">
      <span class="site-footer__top-line"></span>
      <span class="site-footer__top-label">PAGE TOP</span>
    </a>
    <p class="site-footer__copyright">{siteContent.footer.copyright}</p>
  </div>
</footer>
